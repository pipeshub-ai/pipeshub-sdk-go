# Copy to .env and pass the path as the first argument:  go run ./conversation/internal_search .env

# --- Required by every example -------------------------------------------
# Base URL of your PipesHub instance. The examples append /api/v1 themselves.
PIPESHUB_BASE_URL=http://localhost:3000

# --- OAuth2 client credentials ----------------------------------------------
# Used by the programs added in SDK 1.7.1 and by connectors/* (KB/trash/*,
# the non-streaming conversation/* programs, ...). Create an OAuth app with the
# client_credentials grant. The SDK fetches the access token itself.
# PIPESHUB_TOKEN_URL defaults to ${PIPESHUB_BASE_URL}/api/v1/oauth2/token.
PIPESHUB_CLIENT_ID=
PIPESHUB_CLIENT_SECRET=
PIPESHUB_TOKEN_URL=

# --- Email and password ------------------------------------------------------
# The older programs log in with these, unless PIPESHUB_BEARER_AUTH
# (a raw JWT access token, no "Bearer " prefix) is set.
PIPESHUB_TEST_USER_EMAIL=you@example.com
PIPESHUB_TEST_USER_PASSWORD=your-password
PIPESHUB_BEARER_AUTH=

# --- Required by agent_conversation/* (except create_and_add_message) -----
# Key of an existing agent. Create one with:  go run ./agent/create .env
PIPESHUB_AGENT_KEY=

# --- Optional: knowledge filters for agent_conversation/* -----------------
# Leave both empty to let the agent use its own stored knowledge config.
KB_ID=
CONNECTOR_ID=

# --- Optional: lookup names for conversation/* and semantic_search/* ------
# Defaults: SDK-test, and "ABC News RSS" / "abc news" respectively.
# KB/records/reindex_record_group uses the connector named here, or the first
# connector on the instance when empty.
PIPESHUB_KB_NAME=
PIPESHUB_CONNECTOR_NAME=

# --- Optional: model used when an example creates an agent ----------------
# Falls back to the first reasoning-capable LLM on the instance. The
PIPESHUB_AGENT_MODEL_KEY=

# --- Optional: file uploaded by KB/*/upload_records, KB/records/get_record_by_id
# and KB/trash/*. Falls back to a small built-in text file when empty.
PIPESHUB_UPLOAD_PATH=

# --- Single-operation programs (conversation/*, KB/*, connectors/*) ---------
# Each program reads only the ids it needs; create the resource first.
PIPESHUB_CONVERSATION_ID=
PIPESHUB_MESSAGE_ID=       # a bot_response message
PIPESHUB_RUN_ID=           # UUID passed to StreamChat
PIPESHUB_KB_ID=
PIPESHUB_RECORD_ID=
PIPESHUB_RECORD_GROUP_ID=  # connector record group
PIPESHUB_CONNECTOR_ID=
PIPESHUB_CONNECTOR_TYPE=   # e.g. RSS
PIPESHUB_FILTER_KEY=
PIPESHUB_OAUTH_CONFIG_ID=
PIPESHUB_OAUTH_CODE=
PIPESHUB_OAUTH_STATE=
