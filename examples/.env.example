# Copy to .env and pass the path as the first argument:  go run ./conversation/internal_search .env

# --- Required by every example -------------------------------------------
# Base URL of your PipesHub instance. The examples append /api/v1 themselves.
PIPESHUB_BASE_URL=http://localhost:3000

# --- OAuth2 client credentials ----------------------------------------------
# Used by the programs added in SDK 1.7.1 (KB/trash/*,
# the non-streaming conversation/* programs, ...). Create an OAuth app with the
# client_credentials grant. The SDK fetches the access token itself.
# PIPESHUB_TOKEN_URL defaults to ${PIPESHUB_BASE_URL}/api/v1/oauth2/token.
PIPESHUB_CLIENT_ID=
PIPESHUB_CLIENT_SECRET=
PIPESHUB_TOKEN_URL=

# --- Email and password ------------------------------------------------------
# personal_access_tokens/* always log in with these: those routes accept only
# an interactive user session. The older programs use them too, unless
# PIPESHUB_BEARER_AUTH (a raw JWT access token, no "Bearer " prefix) is set.
PIPESHUB_TEST_USER_EMAIL=you@example.com
PIPESHUB_TEST_USER_PASSWORD=your-password
PIPESHUB_BEARER_AUTH=

# --- Required by agent_conversation/* (except create_and_add_message) -----
# Key of an existing agent. Create one with:  go run ./agent/create .env
PIPESHUB_AGENT_KEY=

# --- Optional: knowledge filters for agent_conversation/* -----------------
# Leave both empty to let the agent use its own stored knowledge config.
KB_ID=
CONNECTOR_ID=

# --- Optional: lookup names for conversation/* and semantic_search/* ------
# Defaults: SDK-test, and "ABC News RSS" / "abc news" respectively.
# KB/records/reindex_record_group uses the connector named here, or the first
# connector on the instance when empty.
PIPESHUB_KB_NAME=
PIPESHUB_CONNECTOR_NAME=

# --- Optional: model used when an example creates an agent ----------------
# Falls back to the first reasoning-capable LLM on the instance. The
PIPESHUB_AGENT_MODEL_KEY=

# --- Optional: file uploaded by KB/*/upload_records, KB/records/get_record_by_id
# and KB/trash/*. Falls back to a small built-in text file when empty.
PIPESHUB_UPLOAD_PATH=

# --- Optional: feed for connectors/rss (default Hacker News) ---------------
# The OAuth app needs connector:read, connector:write, connector:sync,
# connector:delete and semantic:write.
PIPESHUB_RSS_FEED_URL=

# connectors/gmail_workspace and connectors/drive_workspace:
# a Google service account key file with domain-wide delegation, the Workspace
# admin email, and optionally the drive to sync and the search queries.
PIPESHUB_GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
PIPESHUB_GOOGLE_ADMIN_EMAIL=
PIPESHUB_GOOGLE_DRIVE_ID=
PIPESHUB_GMAIL_SEARCH_QUERY=
PIPESHUB_DRIVE_SEARCH_QUERY=

# connectors/confluence and connectors/jira: an Atlassian
# API token (https://id.atlassian.com/manage-profile/security/api-tokens),
# and optionally the space or project to sync and the search queries.
PIPESHUB_ATLASSIAN_BASE_URL=https://yourcompany.atlassian.net
PIPESHUB_ATLASSIAN_EMAIL=
PIPESHUB_ATLASSIAN_API_TOKEN=
PIPESHUB_CONFLUENCE_SPACE_KEY=
PIPESHUB_JIRA_PROJECT_KEY=
PIPESHUB_CONFLUENCE_SEARCH_QUERY=
PIPESHUB_JIRA_SEARCH_QUERY=

# connectors/s3: an access key that can list and read the bucket,
# and optionally the bucket to sync and the search query.
PIPESHUB_S3_ACCESS_KEY=
PIPESHUB_S3_SECRET_KEY=
PIPESHUB_S3_BUCKET=
PIPESHUB_S3_SEARCH_QUERY=

# --- connectors/azure_files ------------------------------------------------
# A storage account connection string (quote it), and optionally the one file
# share to sync and the search query.
PIPESHUB_AZURE_FILES_CONNECTION_STRING=
PIPESHUB_AZURE_FILES_SHARE=
PIPESHUB_AZURE_FILES_SEARCH_QUERY=

# --- connectors/slack_workspace --------------------------------------------
# A Slack bot token (xoxb-...), and optionally the one channel to sync and the
# search query.
PIPESHUB_SLACK_BOT_TOKEN=
PIPESHUB_SLACK_CHANNEL_ID=
PIPESHUB_SLACK_SEARCH_QUERY=
